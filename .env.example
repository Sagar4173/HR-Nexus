# ---------------------------------------------------------------------------
# HR Nexus environment configuration
# Copy to .env.local and fill in values. Never commit .env.local.
# ---------------------------------------------------------------------------

# Neon pooled application connection (hostname contains "-pooler")
DATABASE_URL="postgresql://USER:PASSWORD@HOST-POOLER.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Neon direct connection for migrations and COPY loading (no "-pooler")
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Demo session signing secret. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-random-64-character-hex-string"

# Optional: base URL used by scripts/smoke-http.ts (defaults to localhost:3100)
# BASE_URL="http://localhost:3100"
